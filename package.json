{
  "name": "france-budget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:programmes": "node scripts/import-programmes.mjs",
    "test:v2": "node --test scripts/v2/*.node-test.mjs && node scripts/v2/import.mjs --all",
    "audit:editorial:v2": "node scripts/v2/audit-editorial.mjs",
    "docs:check": "node scripts/v2/check-docs.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.3.0",
    "typescript": "^5.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "recharts": "^2.15.0",
    "@neondatabase/serverless": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "vitest": "^3.2.4",
    "@types/node": "^22.15.0"
  }
}
